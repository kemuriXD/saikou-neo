<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">Saikou Neo</string>

    <!-- 1.2 Welcome -->
    <string name="welcome_title">Sign in here. Watch on your TV.</string>
    <string name="welcome_body">Saikou Neo on your phone looks after the things a TV remote is bad at.</string>
    <string name="welcome_sign_in_once">Sign in to AniList once</string>
    <string name="welcome_sign_in_once_body">Your list and progress follow you to every TV.</string>
    <string name="welcome_pair">Pair a TV with its code</string>
    <string name="welcome_pair_body">Scan the code on the TV. Nothing to type with a remote.</string>
    <string name="welcome_finish">Finish what the TV starts</string>
    <string name="welcome_finish_body">Bug reports and new sources come here to finish.</string>
    <string name="welcome_sign_in">Sign in with AniList</string>
    <string name="welcome_browser_note">Opens anilist.co in your browser. Saikou Neo never sees your password.</string>
    <string name="no_browser">There\'s no browser on this phone to open anilist.co.</string>

    <!-- 1.3a Checking with AniList, straight after the browser -->
    <string name="checking_title">Checking with AniList…</string>
    <string name="checking_body">Making sure it\'s your account. This only takes a moment.</string>

    <!-- 1.3 Signed in. %1$s is the AniList user name. -->
    <string name="signed_in_title">Signed in as %1$s</string>
    <string name="signed_in_body">Your AniList list and progress are ready. Pair a TV next so it signs in too.</string>
    <string name="signed_in_pair">Pair a TV</string>

    <!-- 1.4 Sign-in didn't work: what happened, then how to fix it. -->
    <string name="sign_in_try_again">Try again</string>
    <string name="sign_in_no_network">Couldn\'t reach AniList</string>
    <string name="sign_in_no_network_body">Your phone looks offline. Check Wi-Fi or mobile data, then try again. Nothing was saved, so you start the sign-in from the top.</string>
    <string name="sign_in_expired">The sign-in timed out</string>
    <string name="sign_in_expired_body">The AniList page was open for more than 10 minutes. Try again and finish it in one go.</string>
    <string name="sign_in_failed">AniList didn\'t accept the sign-in</string>
    <string name="sign_in_failed_body">Try again. If it keeps happening, sign out of anilist.co in your browser and sign back in.</string>
    <string name="sign_in_not_saved">Couldn\'t finish signing in</string>
    <string name="sign_in_not_saved_body">The phone couldn\'t keep your sign-in. Try again, and restart the phone if it keeps happening.</string>
    <string name="sign_in_session_ended">You\'ve been signed out</string>
    <string name="sign_in_session_ended_body">AniList stopped accepting this phone\'s sign-in, which happens after a while or when you change your password. Sign in again to carry on.</string>
    <string name="sign_in_not_set_up">Sign-in isn\'t set up in this build</string>
    <string name="sign_in_not_set_up_body">It has no AniList client ID. Install a build from the releases page.</string>

    <!-- 2.1 Home: no TVs yet -->
    <string name="home_title_saikou">Saikou</string>
    <string name="home_title_neo">Neo</string>
    <string name="home_account">Account</string>
    <string name="home_pair_first">Pair your first TV</string>
    <string name="home_step_one">On your TV, open Saikou Neo and choose Sign in.</string>
    <string name="home_step_two">Scan the code it shows, or type it in.</string>
    <string name="home_scan">Scan the TV code</string>
    <string name="home_type">Type the code instead</string>
    <string name="home_your_tvs">Your TVs</string>
    <string name="home_no_tvs">No TVs yet. A TV you pair shows up here, ready to send things to or remove.</string>
    <string name="home_pair_tv">Pair a TV</string>
    <!-- %1$s is the day and month the TV was paired, such as 31 Oct. -->
    <string name="home_tv_paired">Signed in · Paired %1$s</string>
    <!-- 2.3 to 2.5 A TV's options, and removing it (ADR 0040: removing only forgets it on the phone). -->
    <!-- %1$s is the TV's name. -->
    <string name="home_tv_options">Options for %1$s</string>
    <string name="home_send_source">Send a source</string>
    <string name="home_send_source_body">Add a link or code to this TV</string>
    <string name="home_remove_tv">Remove this TV</string>
    <string name="home_remove_tv_body">Takes it off Your TVs</string>
    <!-- %1$s is the TV's name. -->
    <string name="home_remove_title">Remove %1$s?</string>
    <string name="home_remove_body">It leaves Your TVs. To sign it out of AniList too, choose Sign out in its Settings > Account.</string>
    <string name="home_remove_cancel">Cancel</string>
    <string name="home_remove_confirm">Remove</string>
    <!-- %1$s is the TV's name. -->
    <string name="home_removed">%1$s removed</string>

    <!-- 3.1 to 3.3 Pair a TV -->
    <string name="pair_title">Pair a TV</string>
    <string name="pair_close">Close</string>
    <string name="pair_looking">Looking for the code…</string>
    <string name="pair_scan_body">Point your camera at the code on your TV. It scans on its own.</string>
    <string name="pair_camera">Camera, pointed at the TV</string>
    <string name="pair_type_instead">Type the code instead</string>
    <string name="pair_camera_off">Camera access is off</string>
    <string name="pair_camera_off_body">To scan the TV’s code, let Saikou Neo use the camera in your phone’s settings. Or type the code shown under it on the TV.</string>
    <string name="pair_open_settings">Open settings</string>
    <string name="pair_type_title">Type the code</string>
    <string name="pair_back">Back</string>
    <string name="pair_type_body">Enter the 6-character code under the QR code on your TV.</string>
    <string name="pair_code_field">TV code</string>
    <plurals name="pair_code_count">
        <item quantity="one">%1$d of %2$d typed</item>
        <item quantity="other">%1$d of %2$d typed</item>
    </plurals>
    <string name="pair_code_hint">Letters and numbers only. Capitals are added for you.</string>
    <string name="pair_connect">Connect</string>

    <!-- 3.4 to 3.8 Pair a TV -->
    <string name="pair_connecting">Connecting to your TV…</string>
    <string name="pair_connecting_body">Keep Saikou Neo open on the TV with the code showing.</string>
    <string name="pair_cancel">Cancel</string>
    <string name="pair_check_title">Does your TV show this code?</string>
    <!-- Read out by TalkBack. %1$s is the six digits with spaces between them, such as 4 8 2 9 1 3. -->
    <string name="pair_check_code">Check code %1$s</string>
    <string name="pair_check_body">Tap It matches only if the numbers are exactly the same. Your AniList account goes to the TV once you do.</string>
    <string name="pair_matches">It matches</string>
    <string name="pair_no_match">It doesn’t match</string>
    <!-- %1$s is the TV's name, such as Living room TV. -->
    <string name="pair_signed_in">%1$s is signed in</string>
    <string name="pair_signed_in_body">It’s in Your TVs now. Send it sources or remove it from there.</string>
    <string name="pair_done">Done</string>
    <string name="pair_unreachable">Couldn’t reach the TV</string>
    <string name="pair_unreachable_body">Check the phone and TV are on the same Wi-Fi, and the TV is still showing its code.</string>
    <string name="pair_try_again">Try again</string>
    <string name="pair_scan_new">Scan a new code</string>
    <string name="pair_stopped_you">You stopped pairing</string>
    <string name="pair_stopped_you_body">Nothing was sent to the TV. It still shows its code, so you can try again.</string>
    <string name="pair_stopped_cancelled">Cancelled on the TV</string>
    <string name="pair_stopped_cancelled_body">Pairing was cancelled on the TV, so nothing was sent. Choose Sign in on the TV to get a new code.</string>
    <string name="pair_stopped_refused">The TV couldn’t sign in</string>
    <string name="pair_stopped_refused_body">AniList didn’t accept your account on the TV. Sign in to AniList again on this phone, then pair the TV.</string>
    <string name="pair_stopped_timed_out">The TV stopped waiting</string>
    <string name="pair_stopped_timed_out_body">The codes weren’t checked in time. The TV still shows its code, so you can try again.</string>
    <string name="pair_sign_in_again">Sign in again</string>
    <string name="pair_start_again">Start again</string>
    <string name="pair_back_home">Back to Home</string>

    <!-- 4.1 to 4.10 Send a source (ADR 0042). The phone sends only the ticked entries; the TV checks them again. -->
    <string name="send_title">Send a source</string>
    <string name="send_scan_body">On the TV, open Sources and choose Add from my phone. Then point your camera at the code. It scans on its own.</string>
    <string name="send_connecting">Connecting to the TV…</string>
    <string name="send_connecting_body">Keep Add from my phone open on the TV.</string>
    <string name="send_check_body">Tap It matches only if the numbers are exactly the same, and choose It matches on the TV too. Then you can pick sources to send.</string>
    <!-- %1$s is the TV's name, such as Living room TV. -->
    <string name="send_to">To %1$s</string>
    <string name="send_link_body">Paste the link or short code for a source or a list of sources.</string>
    <string name="send_link_field">Link or code</string>
    <string name="send_link_hint">A list lets you pick which sources to send.</string>
    <string name="send_checking">Checking the link…</string>
    <string name="send_trust">Sources run inside the app. Only add ones you trust.</string>
    <string name="send_check_link">Check link</string>
    <string name="send_error_code">No source has that code. Check it and try again.</string>
    <string name="send_error_not_secure">That link isn’t secure. Use one that starts with https://.</string>
    <string name="send_error_not_a_source">This link isn’t a source or a list of sources.</string>
    <string name="send_error_broken_list">Couldn’t read the list at that link. Check it and try again.</string>
    <string name="send_pick_title">Pick sources</string>
    <string name="send_back">Back</string>
    <!-- %1$s is the link without https://, such as example.org/sources.json. -->
    <string name="send_from_list">From %1$s. Tick the ones to send.</string>
    <string name="send_from">From %1$s.</string>
    <string name="send_nothing_fits">Nothing in this list can be added. Every source is installed or needs a newer version of the app.</string>
    <!-- %1$s is a version, such as 2.1.0. -->
    <string name="send_version">Version %1$s</string>
    <string name="send_update">Update from %1$s to %2$s</string>
    <string name="send_installed">Installed, version %1$s</string>
    <string name="send_add_again">Installed. Tick to get updates</string>
    <string name="send_needs_newer_app">Needs a newer version of the app</string>
    <string name="send_needs_newer_source">Built for an older version of the app</string>
    <string name="send_does_not_work">Doesn’t work with this version of the app</string>
    <string name="send_one_apk">One source, checked on the TV</string>
    <string name="send_to_tv">Send to TV</string>
    <plurals name="send_count">
        <item quantity="one">Send %d source</item>
        <item quantity="other">Send %d sources</item>
    </plurals>
    <!-- %1$s is the TV's name. -->
    <string name="send_sent">%1$s has the list</string>
    <string name="send_sent_body">Finish on the TV: it lists what’s arriving and installs nothing until you press Install.</string>
    <string name="send_done">Done</string>
    <!-- %1$s is the TV's name. -->
    <string name="send_lost">Lost the connection to %1$s</string>
    <string name="send_lost_body">Open Add from my phone on the TV again, then scan its new code.</string>
    <string name="send_no_match">The codes don’t match</string>
    <string name="send_no_match_body">Nothing was sent. Someone else may be connecting, so scan the code on the TV again and check it before you tap It matches.</string>
    <!-- %1$s is the TV's name. -->
    <string name="send_no_match_tv">%1$s says the codes don’t match</string>
    <string name="send_no_match_tv_body">Someone else may be connecting. Open Add from my phone on the TV again and check the code before you tap It matches.</string>
    <!-- %1$s is the TV's name. -->
    <string name="send_stopped_tv">Stopped on %1$s</string>
    <string name="send_stopped_tv_body">Open Add from my phone on the TV again to send sources.</string>
    <!-- %1$s is the TV's name. -->
    <string name="send_timed_out">%1$s stopped waiting</string>
    <string name="send_timed_out_body">Nothing was sent in time. The TV still shows its code, so you can scan it again.</string>
    <!-- %1$s is the TV's name. -->
    <string name="send_refused">%1$s didn’t take the sources</string>
    <string name="send_refused_body">Nothing will install. The TV still shows its code, so you can scan it again and try another link.</string>
    <string name="send_scan_again">Scan again</string>

    <!-- 6.1 Account -->
    <string name="account_title">Account</string>
    <string name="account_back">Back</string>
    <string name="account_signed_in_with">Signed in with AniList</string>
    <string name="account_about">About</string>
    <string name="account_profile">AniList profile</string>
    <string name="account_profile_body">Opens anilist.co</string>
    <string name="account_crash_reports">Send crash reports</string>
    <string name="account_crash_reports_body">When the app crashes, send a report so it can be fixed. It includes your AniList name and ID, device details and recent app logs.</string>
    <string name="account_version">Version</string>
    <string name="account_sign_out">Sign out</string>

    <!-- 6.2 Account: sign out? -->
    <string name="account_sign_out_title">Sign out on this phone?</string>
    <string name="account_sign_out_body">Your TVs stay signed in. To sign one out, choose Sign out in its Settings > Account.</string>
    <string name="account_sign_out_cancel">Cancel</string>
</resources>
