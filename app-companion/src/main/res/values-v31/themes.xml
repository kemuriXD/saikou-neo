<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every phone on Android 12 and later shows the system splash, so it gets the same still lockup (ADR 0022). -->
    <style name="Theme.SaikouNeo" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:windowSplashScreenBackground">@color/ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
