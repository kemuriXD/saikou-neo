<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The AniList account is sealed with a key that never leaves this phone, so it stays here. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="anilist_account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="anilist_account.xml" />
    </device-transfer>
</data-extraction-rules>
