<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. The AniList account is sealed with a key that never leaves this phone, so it stays here, and so does Your TVs,
     since the account is what signs those TVs in. A TV's pairing ID stays too, so two TVs never share one. -->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="anilist_account.xml" />
    <exclude
        domain="sharedpref"
        path="paired_tvs.xml" />
    <exclude
        domain="sharedpref"
        path="tv_identity.xml" />
</full-backup-content>
