    <color name="saikou_neo_symbol">#FFFF4F91</color>
    <!-- The pinks of the original Saikou launcher icon and banner. Preview builds turn them green in each UI module. -->
    <color name="saikou_neo_icon_pink">#FFFF0080</color>
    <color name="saikou_neo_icon_pink_light">#FFFF4BA8</color>
    <color name="saikou_neo_icon_pink_deep">#FFC50053</color>
