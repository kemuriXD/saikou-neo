    <!-- Paper matches NeoColors.paper, for "Saikou" in the splash lockup. -->
    <color name="paper">#FFF6F5F2</color>
    <!-- Text muted matches NeoColors.textMuted, for the splash's loading line. -->
    <color name="text_muted">#B8F6F5F2</color>
