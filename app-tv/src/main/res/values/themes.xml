<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ink matches NeoColors.ink, so there's no grey flash before Compose draws. -->
    <color name="ink">#FF11121C</color>
    <!-- Paper matches NeoColors.paper, for "Saikou" in the splash lockup. -->
    <color name="paper">#FFF6F5F2</color>

    <!-- The window background is the splash until Home draws (ADR 0018). values-v31 adds the system splash. -->
    <style name="Theme.SaikouNeo" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:colorBackground">@color/ink</item>
    </style>
</resources>
