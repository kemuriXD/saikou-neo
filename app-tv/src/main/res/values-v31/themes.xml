<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Google TV shows no system splash, so the window background draws the lockup as below Android 12. Where a TV
        does show the system splash, it gets the smaller lockup that fits its icon.
    -->
    <style name="Theme.SaikouNeo" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:windowSplashScreenBackground">@color/ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
