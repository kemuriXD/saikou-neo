<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- To tell no connection at once, instead of waiting for a request to time out. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- TV-only app: no touchscreen, and leanback isn't required so Fire TV can install it. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".NeoApp"
        android:banner="@mipmap/saikou_neo_banner"
        android:icon="@mipmap/saikou_neo_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SaikouNeo">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Android TV and Google TV launchers. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Fire TV's launcher. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
